# Docker/Compose build and runtime settings
# This is the Codex CLI version validated by CI for this repository revision.
CODEX_VERSION=0.154.0
CODEX_UID=1000
CODEX_GID=1000
CODEX_WEB_BIND=127.0.0.1
CODEX_WEB_PORT=8765
CODEX_WORKSPACE=./workspace

# Structured runtime logging. Values follow Python logging levels.
CODEX_WEB_LOG_LEVEL=INFO

# Native Codex context compaction. Set the percentage to 0 to disable automatic
# compaction while retaining the manual Compact context control.
CODEX_WEB_AUTO_COMPACT_PERCENT=75
CODEX_WEB_COMPACT_COOLDOWN_SECONDS=300

# Executive conversation context. History is read with this approximate token
# ceiling and older turns are compacted toward the target after a response.
CODEX_WEB_EXECUTIVE_MAX_CONTEXT_TOKENS=12000
CODEX_WEB_EXECUTIVE_COMPACT_TARGET_TOKENS=6000

# Inbound webhook verification. Leave blank only if that integration is unused;
# configured webhook routes fail closed when their verification secret is absent.
SLACK_SIGNING_SECRET=
TELEGRAM_WEBHOOK_SECRET=
CODEX_WEB_GITLAB_WEBHOOK_SECRET=

# Optional outbound/integration credentials
CODEX_WEB_GITLAB_TOKEN=
