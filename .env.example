# Docker/Compose build and runtime settings
# Trusted runtime base published from main. Pin an immutable base-<commit> tag
# here when reproducing or rolling back a specific runtime foundation.
CODEX_WEB_BASE_IMAGE=garnser/codex-web:base
# This is the Codex CLI version validated by CI for this repository revision.
CODEX_VERSION=0.154.0
CODEX_UID=1000
CODEX_GID=1000
CODEX_WEB_BIND=127.0.0.1
CODEX_WEB_PORT=8765
# Host directory mounted read/write at /workspace by Compose. Prefer an absolute
# path when migrating project records created by a previous native deployment;
# Compose also exposes that value as CODEX_WEB_WORKSPACE_SOURCE_ROOT so stored
# absolute paths below it can be rewritten to portable relative paths.
CODEX_WORKSPACE=./workspace

# Native/non-Compose deployments may set CODEX_WEB_WORKSPACE_ROOT to make
# project paths portable in the same way. Compose sets this to /workspace.
# CODEX_WEB_WORKSPACE_ROOT=/srv/development
# CODEX_WEB_WORKSPACE_SOURCE_ROOT=/old/native/workspace

# Shared/replicated control-plane foundation. The default local deployment uses
# SQLite + in-process EventTransport and requires no PostgreSQL/Redis packages.
# Install requirements-distributed.txt before selecting PostgreSQL or Redis.
CODEX_WEB_STATE_BACKEND=sqlite
# CODEX_WEB_POSTGRES_DSN=postgresql://codex:secret@127.0.0.1:5432/codex
CODEX_WEB_EVENT_TRANSPORT=in-process
# CODEX_WEB_REDIS_URL=redis://127.0.0.1:6379/0
CODEX_WEB_REDIS_STREAM=codex-web:events
CODEX_WEB_REDIS_GROUP=codex-web
CODEX_WEB_DEPLOYMENT_MODE=local
# Use a stable unique ID per replicated control-plane instance.
# CODEX_WEB_INSTANCE_ID=codex-web-a
CODEX_WEB_COORDINATION_LEASE_SECONDS=30

# Structured runtime logging. Values follow Python logging levels.
CODEX_WEB_LOG_LEVEL=INFO

# Native Codex context compaction. Set the percentage to 0 to disable automatic
# compaction while retaining the manual Compact context control.
CODEX_WEB_AUTO_COMPACT_PERCENT=75
CODEX_WEB_COMPACT_COOLDOWN_SECONDS=300

# Executive conversation context. History is read with this approximate token
# ceiling and older turns are compacted toward the target after a response.
CODEX_WEB_EXECUTIVE_MAX_CONTEXT_TOKENS=12000
CODEX_WEB_EXECUTIVE_COMPACT_TARGET_TOKENS=6000

# Inbound webhook verification. Leave blank only if that integration is unused;
# configured webhook routes fail closed when their verification secret is absent.
SLACK_SIGNING_SECRET=
TELEGRAM_WEBHOOK_SECRET=
CODEX_WEB_GITLAB_WEBHOOK_SECRET=

# Optional outbound/integration credentials
CODEX_WEB_GITLAB_TOKEN=
