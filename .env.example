# Docker/Compose build and runtime settings
CODEX_VERSION=latest
CODEX_UID=1000
CODEX_GID=1000
CODEX_WEB_BIND=127.0.0.1
CODEX_WEB_PORT=8765
CODEX_WORKSPACE=./workspace

# Inbound webhook verification. Leave blank only if that integration is unused;
# configured webhook routes fail closed when their verification secret is absent.
SLACK_SIGNING_SECRET=
TELEGRAM_WEBHOOK_SECRET=
CODEX_WEB_GITLAB_WEBHOOK_SECRET=

# Optional outbound/integration credentials
CODEX_WEB_GITLAB_TOKEN=
