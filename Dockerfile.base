# syntax=docker/dockerfile:1.7

FROM python:3.14-slim-bookworm

ARG CODEX_VERSION=0.154.0
ARG CLAUDE_CODE_VERSION=2.1.276

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# This image contains only the slow, rarely-changing runtime dependencies used by
# codex-web. The application source and runtime UID/GID remain in Dockerfile so
# normal PR builds only add a small application layer on top of this base.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        openssh-client \
        ripgrep \
        tini \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install --global --omit=dev "@openai/codex@${CODEX_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && codex --version \
    && claude --version \
    && node --version \
    && npm --version \
    && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /opt/codex-web-base
COPY requirements.txt requirements.lock ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.lock \
    && rm -f requirements.txt requirements.lock

WORKDIR /app
