map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;

    server_name dev.veridataops.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }

    location = /admin {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        return 302 /admin/;
    }

    location = /codex {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        return 302 /codex/;
    }

    location ^~ /codex/ {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        proxy_pass http://127.0.0.1:8765/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /codex;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location = /devstatus {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        proxy_pass http://127.0.0.1:8765/devstatus;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location = /devhealth {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        proxy_pass http://127.0.0.1:8765/devhealth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location = /devhealth/ {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        proxy_pass http://127.0.0.1:8765/devhealth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }


    location /admin/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        rewrite ^/admin/?(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:5201;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /admin;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }


    location = /pypi {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        return 301 /pypi/;
    }


    location ^~ /pypi/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:3141/;
        client_max_body_size 100m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /pypi;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
        proxy_redirect off;
    }


    location /license-validation/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:5201;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    location /distribution/data-packs/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:5202;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    location / {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }


}

server {
    listen 443 ssl;

    http2 on;
    server_name dev.veridataops.com;

    ssl_certificate /etc/letsencrypt/live/dev.veridataops.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.veridataops.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 25m;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /admin {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        return 302 /admin/;
    }

    location = /codex {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        return 302 /codex/;
    }

    location ^~ /codex/ {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        proxy_pass http://127.0.0.1:8765/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /codex;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location = /devstatus {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        proxy_pass http://127.0.0.1:8765/devstatus;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location = /devhealth {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        proxy_pass http://127.0.0.1:8765/devhealth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location = /devhealth/ {
        satisfy any;
        include /etc/nginx/snippets/codex-allowlist.conf;
        include /etc/nginx/snippets/codex-basic-auth.conf;
        proxy_pass http://127.0.0.1:8765/devhealth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }


    location /admin/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        rewrite ^/admin/?(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:5201;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /admin;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }


    location = /pypi {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        return 301 /pypi/;
    }


    location ^~ /pypi/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:3141/;
        client_max_body_size 100m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /pypi;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
        proxy_redirect off;
    }


    location /license-validation/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:5201;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    location /distribution/data-packs/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:5202;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    location = /gitlab {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        return 301 /gitlab/;
    }


    location ^~ /gitlab/api/v4/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:8081;
        client_max_body_size 0;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
        proxy_redirect off;
    }


    location /gitlab/ {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:8081;
        client_max_body_size 0;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
        proxy_redirect off;
    }


    location / {
        include /etc/nginx/snippets/dev-veridataops-allowlist.conf;
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }


}
